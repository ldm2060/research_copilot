{
  "name": "@research-copilot/cli",
  "version": "1.1.17",
  "description": "Multi-platform AI research assistant with MCP integration and skillpacks",
  "type": "module",
  "bin": {
    "rc": "./dist/rc.js"
  },
  "files": [
    "dist",
    "README.md",
    "research-kit"
  ],
  "keywords": [
    "ai",
    "research",
    "mcp",
    "claude",
    "gemini",
    "cursor"
  ],
  "author": "ldm2060",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldm2060/research_copilot.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup bin/rc.ts --format esm && npm run copy-kit",
    "copy-kit": "node -e \"require('fs').cpSync('../../research-kit', 'research-kit', {recursive: true, filter: (src) => !src.includes('.git')})\""
  },
  "dependencies": {
    "@research-copilot/core": "workspace:*",
    "@research-copilot/adapters": "workspace:*",
    "commander": "^12.1.0"
  }
}
